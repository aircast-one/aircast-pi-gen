#!/bin/sh
# initramfs-tools hook: pull the overlay module and the tools the local-bottom
# script needs (findfs, modprobe, mount helpers) into the initramfs.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

. /usr/share/initramfs-tools/hook-functions

manual_add_modules overlay
copy_exec /sbin/findfs /sbin
copy_exec /sbin/modprobe /sbin 2>/dev/null || true
