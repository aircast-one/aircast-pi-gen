#!/bin/sh
# initramfs-tools init-premount: associate wlan0 before the crypttab/Clevis
# local-top unlock runs, so a wifi-only device can reach its Tang server at boot.
# init-premount runs before local-top, so wlan0 is associated by the time Clevis
# calls configure_networking (which then DHCPs wlan0, per DEVICE=wlan0).
#
# No-op unless a wifi config was staged (wired/plaintext cards skip it). Every
# failure path is non-fatal: a card that can't bring wifi up falls through to
# Clevis, which blocks for the recovery passphrase.
#
# !!! Boot path UNVERIFIED — must be confirmed on a spare SD.
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

. /scripts/functions

CONF=/etc/wpa_supplicant/aircast-initramfs.conf
[ -f "$CONF" ] || exit 0

modprobe brcmfmac 2>/dev/null || true
modprobe cfg80211 2>/dev/null || true

# Wait for the interface to appear (firmware load can lag the modprobe).
i=0
while [ ! -d /sys/class/net/wlan0 ] && [ "$i" -lt 10 ]; do
	sleep 1
	i=$((i + 1))
done
if [ ! -d /sys/class/net/wlan0 ]; then
	log_failure_msg "aircast-wifi: wlan0 never appeared; leaving unlock to the recovery passphrase"
	exit 0
fi

ip link set wlan0 up 2>/dev/null || true
mkdir -p /run/wpa_supplicant
wpa_supplicant -B -Dnl80211,wext -i wlan0 -c "$CONF" 2>/dev/null \
	|| { log_failure_msg "aircast-wifi: wpa_supplicant failed to start"; exit 0; }

# Wait for association so the DHCP that Clevis triggers has a link to run on.
i=0
while [ "$i" -lt 30 ]; do
	if wpa_cli -i wlan0 status 2>/dev/null | grep -q '^wpa_state=COMPLETED'; then
		log_success_msg "aircast-wifi: wlan0 associated"
		exit 0
	fi
	sleep 1
	i=$((i + 1))
done
log_failure_msg "aircast-wifi: wlan0 did not associate in time; leaving unlock to the recovery passphrase"
exit 0
