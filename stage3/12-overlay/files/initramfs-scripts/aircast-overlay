#!/bin/sh
PREREQ="aircast-bootlog-stop"
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac

. /scripts/functions

DATA=/run/aircast-data
DATA_DEV=/dev/disk/by-label/data
[ -b /dev/mapper/data ] && DATA_DEV=/dev/mapper/data

[ -b "$DATA_DEV" ] || exit 0

modprobe overlay 2>/dev/null || true
mkdir -p "$DATA"
mount -t ext4 "$DATA_DEV" "$DATA" || { log_failure_msg "aircast-overlay: mount data failed; booting without overlay"; exit 0; }

wipe_upper() {
	rm -rf "$DATA/overlay/upper" "$DATA/overlay/work" 2>/dev/null || true
}

BOOT=/run/aircast-boot
BOOT_DEV=$(findfs LABEL=bootfs 2>/dev/null || true)
[ -b "$BOOT_DEV" ] || BOOT_DEV=/dev/disk/by-label/bootfs
mkdir -p "$BOOT"
if [ -b "$BOOT_DEV" ] && mount -t vfat -o rw "$BOOT_DEV" "$BOOT" 2>/dev/null; then
	if [ -f "$BOOT/factory-reset" ] && rm -f "$BOOT/factory-reset" 2>/dev/null; then
		sync
		log_warning_msg "aircast-overlay: factory reset requested — wiping writable layer"
		wipe_upper
	fi
	if [ ! -f "$BOOT/aircast-installed" ]; then
		if touch "$BOOT/aircast-installed" 2>/dev/null; then
			sync
			log_warning_msg "aircast-overlay: freshly flashed card — discarding the previous install's writable layer"
			wipe_upper
		else
			log_failure_msg "aircast-overlay: boot partition not writable; keeping the previous install's writable layer"
		fi
	fi
	umount "$BOOT" 2>/dev/null || true
else
	log_warning_msg "aircast-overlay: boot partition unavailable; cannot process a pending factory-reset flag"
fi

mkdir -p "$DATA/overlay/upper" "$DATA/overlay/work"

LOWER=/run/aircast-lower
NEWROOT=/run/aircast-newroot

fallback_rw() {
	log_failure_msg "aircast-overlay: $1; booting plain read-write root"
	umount "$NEWROOT" 2>/dev/null || true
	umount "$LOWER" 2>/dev/null || true
	umount "$DATA" 2>/dev/null || true
	exit 0
}

mkdir -p "$LOWER" "$NEWROOT"
mount --bind "$rootmnt" "$LOWER" || fallback_rw "bind lower failed"
mount -o remount,ro,bind "$LOWER" 2>/dev/null || true

mount -t overlay aircast-overlay \
	-o "lowerdir=$LOWER,upperdir=$DATA/overlay/upper,workdir=$DATA/overlay/work" \
	"$NEWROOT" || fallback_rw "overlay mount failed"

mkdir -p "$NEWROOT/data" "$NEWROOT/mnt/lower"
mount --move "$DATA" "$NEWROOT/data" || { umount "$NEWROOT" 2>/dev/null || true; fallback_rw "could not move data into overlay"; }
mount --move "$LOWER" "$NEWROOT/mnt/lower" 2>/dev/null || true

if ! mount --move "$NEWROOT" "$rootmnt"; then
	mount --move "$NEWROOT/mnt/lower" "$LOWER" 2>/dev/null || true
	mount --move "$NEWROOT/data" "$DATA" 2>/dev/null || true
	umount "$NEWROOT" 2>/dev/null || true
	fallback_rw "could not pivot to overlay"
fi
