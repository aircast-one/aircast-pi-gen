[Unit]
Description=aircastd device control plane (HTTP :80, manages mediamtx + in-process MAVLink router)
After=network-online.target tailscaled.service cloud-final.service
Wants=network-online.target
# Crash-loop protection: allow 20 restarts per 5 minutes.
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
# aircastd binds port 80 and calls systemctl to manage mediamtx, so it
# runs as root.
User=root
Group=root
ExecStart=/usr/local/bin/aircastd
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
