[connection]
id=usb-gadget
uuid=8f2a1c5e-3b47-4d9a-bc16-2e7f9a0d4411
type=ethernet
interface-name=usb0
autoconnect=true
# Bring usb0 up promptly, but keep it well below cellular/LAN so it never
# becomes the device's default uplink.
autoconnect-priority=20

[ethernet]

[ipv4]
# Shared mode: NetworkManager assigns the Pi 10.55.0.1, runs a small dnsmasq to
# lease 10.55.0.0/24 addresses to the connected computer, and NATs out. So a
# freshly-cabled laptop just gets an IP and can reach ssh pi@10.55.0.1.
method=shared
address1=10.55.0.1/24
# usb0 is a local management link, never the route to the internet.
never-default=true
route-metric=700

[ipv6]
method=ignore
