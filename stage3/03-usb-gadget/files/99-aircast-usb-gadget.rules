# Re-assert the USB Ethernet gadget whenever a peripheral-capable UDC appears or
# changes role. dr_mode=otg means the port is host while the modem/flight
# controller are attached and only becomes a device when cabled to a computer;
# that transition happens after boot, long after the oneshot service ran. This
# rebinds the gadget on the host->device switch. try-restart is a no-op until
# the boot-time service is active, and --no-block keeps the udev worker free.
ACTION=="add|change", SUBSYSTEM=="udc", RUN+="/bin/systemctl --no-block try-restart aircast-usb-gadget.service"
