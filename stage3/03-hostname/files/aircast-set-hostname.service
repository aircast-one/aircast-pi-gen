[Unit]
Description=Set a unique per-device hostname on first boot
# Must run before anything that reads the hostname: NetworkManager activates the
# AP, the SSID service stamps it into the keyfile, and Tailscale registers with
# it. Ordered ahead of all three.
After=local-fs.target
Before=network-pre.target NetworkManager.service aircast-hotspot-ssid.service
ConditionPathExists=!/var/lib/aircast/hostname-set

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aircast-set-hostname.sh

[Install]
WantedBy=multi-user.target
