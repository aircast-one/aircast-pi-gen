[Unit]
Description=Set Wi-Fi hotspot SSID to the device hostname
# The hostname is set on first boot by cloud-init (the flasher writes it to the
# boot partition). Run after it is finalized and after NetworkManager is up,
# then reload so the AP broadcasts the right SSID. Idempotent: on later boots
# the keyfile already matches and this no-ops.
After=cloud-init.service NetworkManager.service
Wants=NetworkManager.service
ConditionPathExists=/etc/NetworkManager/system-connections/hotspot.nmconnection

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aircast-hotspot-ssid.sh

[Install]
WantedBy=multi-user.target
