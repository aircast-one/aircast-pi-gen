[Unit]
Description=Set Wi-Fi hotspot SSID to the device hostname
# Rewrite the SSID before NetworkManager activates the AP, so it broadcasts the
# right name the moment it comes up. Hostname is applied by systemd well before.
After=systemd-hostnamed.service
Before=NetworkManager.service
ConditionPathExists=/etc/NetworkManager/system-connections/hotspot.nmconnection

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/aircast-hotspot-ssid.sh

[Install]
WantedBy=multi-user.target
